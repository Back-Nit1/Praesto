node_modules/
.wxt/
.output/
coverage/

# The unpacked extension build. Ignored because it is generated - run
# `npm run build` to produce it, then load dist/chrome-mv3 in Chrome.
dist/
*.local
.DS_Store
*.log

# Applicant data must never be committed. The extension stores everything in
# browser storage, but developers export JSON profiles for debugging (see
# Phase 1 import/export) and those files contain real PII.
*.profile.json
/local/

# Local secrets. Note that a .env only keeps a key out of git - Vite INLINES
# import.meta.env values into the bundle, and the bundle ships to every user.
# See SECURITY.md before putting any credential in one.
.env
.env.*
!.env.example

# Working notes, not deliverables. Kept out of the repo by request.
engineering.md

# The security model document. Deliberately NOT committed: it is the written
# threat model and the map of every trust boundary, and this repository may not
# stay private. Keep it beside the code, share it deliberately.
Security.md

# Playwright output
test-results/
playwright-report/
