{
  "name": "applicant-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal Job Application Agent - a Chrome MV3 extension that fills job applications from a verified applicant profile, and refuses to guess.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && npm run scan:secrets",
    "scan:secrets": "node scripts/check-bundle-secrets.mjs dist",
    "zip": "wxt zip",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run compile && npm run test"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.0.313",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.1.0",
    "@wxt-dev/module-react": "^1.1.3",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "wxt": "^0.20.27"
  }
}
